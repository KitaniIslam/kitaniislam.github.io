---
const toBasePath = (value: string) => {
  if (typeof value !== 'string' || !value.startsWith('/')) return value;
  const base = import.meta.env.BASE_URL;
  const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
  return `${normalizedBase}${value}`;
};

const navItems = [
  { label: 'Home', href: '/#home', icon: 'fa-solid fa-house' },
  { label: 'Services', href: '/#services', icon: 'fa-solid fa-screwdriver-wrench' },
  { label: 'Work', href: '/#case-study', icon: 'fa-solid fa-briefcase' },
  { label: 'Stack', href: '/#tech', icon: 'fa-solid fa-layer-group' },
  { label: 'Experience', href: '/#experience', icon: 'fa-solid fa-chart-line' },
  { label: 'Contact', href: '/#footer', icon: 'fa-solid fa-envelope' }
];
---

<header class="topbar resume-site-nav" data-nav>
  <a href={toBasePath('/#home')} class="brand-mark resume-home-mark" aria-label="Back to portfolio home"><span aria-hidden="true">🚀</span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-label="Toggle navigation" data-menu-toggle>
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav class="topnav" data-menu>
    {navItems.map((item) => (
      <a href={toBasePath(item.href)}>
        <i class={`nav-icon ${item.icon}`} aria-hidden="true"></i>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
  <button class="button nav-cta" type="button" data-contact-open>
    <span>Let's Talk</span>
    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
  </button>
</header>
