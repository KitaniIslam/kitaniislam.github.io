---
const toBasePath = (value: string) => {
  if (typeof value !== 'string' || !value.startsWith('/')) return value;
  const base = import.meta.env.BASE_URL;
  const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
  return `${normalizedBase}${value}`;
};

const navItems = [
  { label: 'Home', href: '/#home', icon: 'home' },
  { label: 'Services', href: '/#services', icon: 'services' },
  { label: 'Work', href: '/#case-study', icon: 'work' },
  { label: 'Stack', href: '/#tech', icon: 'stack' },
  { label: 'Experience', href: '/#experience', icon: 'experience' },
  { label: 'Contact', href: '/#footer', icon: 'contact' }
];
---

<svg class="icon-sprite" aria-hidden="true">
  <symbol id="nav-home" viewBox="0 0 24 24">
    <path d="M4 11.5 12 5l8 6.5" />
    <path d="M7 10.5V19h10v-8.5" />
  </symbol>
  <symbol id="nav-services" viewBox="0 0 24 24">
    <path d="M12 4v16" />
    <path d="M16 7.5h-5.5a2.5 2.5 0 0 0 0 5H13.5a2.5 2.5 0 0 1 0 5H8" />
  </symbol>
  <symbol id="nav-work" viewBox="0 0 24 24">
    <path d="M5 8h14v11H5z" />
    <path d="M9 8V5h6v3" />
  </symbol>
  <symbol id="nav-stack" viewBox="0 0 24 24">
    <path d="m12 4 8 4-8 4-8-4 8-4Z" />
    <path d="m4 13 8 4 8-4" />
  </symbol>
  <symbol id="nav-experience" viewBox="0 0 24 24">
    <path d="M5 18h14" />
    <path d="M7 18V9" />
    <path d="M12 18V6" />
    <path d="M17 18v-4" />
  </symbol>
  <symbol id="nav-contact" viewBox="0 0 24 24">
    <path d="M5 7h14v10H5z" />
    <path d="m5 8 7 5 7-5" />
  </symbol>
</svg>

<header class="topbar resume-site-nav" data-nav>
  <a href={toBasePath('/#home')} class="hero-badge resume-home-mark" aria-label="Back to portfolio home"><span>🚀</span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-label="Toggle navigation" data-menu-toggle>
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav class="topnav" data-menu>
    {navItems.map((item) => (
      <a href={toBasePath(item.href)}>
        <svg class="nav-icon" aria-hidden="true">
          <use href={`#nav-${item.icon}`}></use>
        </svg>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
  <button class="button nav-cta" type="button" data-contact-open>Let's Talk</button>
</header>
