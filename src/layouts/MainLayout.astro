---
const {
  title = 'Kitani Islam | Lead Full-Stack Engineer',
  description = 'Lead full-stack engineer portfolio for React, React Native, Node.js, backend systems, AI integration, RAG workflows, and product delivery.',
  image = '/images/me.webp',
  type = 'website'
} = Astro.props;
import '../styles/global.css';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const imageUrl = new URL(image, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Kitani Islam" />
    <meta name="keywords" content="Kitani Islam, lead full-stack engineer, React developer, React Native developer, Next.js developer, TypeScript developer, Node.js developer, GraphQL, REST APIs, PostgreSQL, AWS, Docker, AI integration, RAG workflows, product engineering, technical leadership, Kuala Lumpur software engineer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Kitani Islam Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script async src="https://contra.com/static/embed/sdk.js" charset="utf-8"></script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="c638cbe0-bc95-4057-a46f-ed5eba149ec6"></script>
  </head>
  <body>
    <slot />
    <button class="scroll-to-top" type="button" aria-label="Scroll to top" data-scroll-to-top>
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>
    <script is:inline>
      const contactModal = document.querySelector('[data-contact-modal]');
      if (contactModal) {
        const openTriggers = document.querySelectorAll('[data-contact-open]');
        const closeTriggers = contactModal.querySelectorAll('[data-contact-close]');
        const openModal = () => {
          contactModal.hidden = false;
          document.body.style.overflow = 'hidden';
        };
        const closeModal = () => {
          contactModal.hidden = true;
          document.body.style.overflow = '';
        };
        openTriggers.forEach((trigger) => {
          trigger.addEventListener('click', openModal);
        });
        closeTriggers.forEach((trigger) => {
          trigger.addEventListener('click', closeModal);
        });
        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeModal();
        });
      }

      const navRoot = document.querySelector('[data-nav]');
      const menuToggle = navRoot?.querySelector('[data-menu-toggle]');
      const menu = navRoot?.querySelector('[data-menu]');
      const navLinks = menu?.querySelectorAll('a') ?? [];

      const setMenuState = (open) => {
        if (!navRoot || !menuToggle || !menu) return;
        navRoot.classList.toggle('menu-open', open);
        menuToggle.setAttribute('aria-expanded', String(open));
      };

      menuToggle?.addEventListener('click', () => {
        const isOpen = navRoot?.classList.contains('menu-open');
        setMenuState(!isOpen);
      });

      navLinks.forEach((link) => {
        link.addEventListener('click', () => setMenuState(false));
      });

      const scrollToTop = document.querySelector('[data-scroll-to-top]');
      const updateScrollToTop = () => {
        scrollToTop?.classList.toggle('is-visible', window.scrollY > 500);
      };

      window.addEventListener('scroll', updateScrollToTop, { passive: true });
      updateScrollToTop();
      scrollToTop?.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      });
    </script>
  </body>
</html>
