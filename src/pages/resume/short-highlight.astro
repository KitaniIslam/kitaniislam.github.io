---
import MainLayout from '../../layouts/MainLayout.astro';
import ContactModal from '../../components/ContactModal.astro';
import ResumeNav from '../../components/ResumeNav.astro';
import portfolio from '../../data/portfolio.json';

const toBasePath = (value: string) => {
  if (typeof value !== 'string' || !value.startsWith('/')) return value;
  const base = import.meta.env.BASE_URL;
  const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
  return `${normalizedBase}${value}`;
};

const shortPdf = '/cv/Kitani-Islam-CV-Short.pdf';
const shortPdfPreview = `${shortPdf}#view=Fit&zoom=page-fit`;
const detailedPath = '/resume/detailed-cv';
---

<MainLayout
  title="Kitani Islam Short CV | Lead Full-Stack Engineer"
  description="Short highlight CV for Kitani Islam, lead full-stack engineer focused on React, React Native, Node.js, product delivery, and technical leadership."
>
  <main class="resume-page-shell">
    <ResumeNav />

    <section class="resume-viewer-section" aria-label="Short CV preview">
      <div class="resume-preview-toolbar">
        <div class="resume-preview-top">
          <div class="resume-preview-copy">
            <p class="project-section-label">Resume preview</p>
            <h1>Short Highlight CV</h1>
          </div>
          <a class="button resume-download-button" href={toBasePath(shortPdf)} download aria-label="Download short CV copy">
            <i class="fa-solid fa-download" aria-hidden="true"></i>
            <span>Short copy</span>
          </a>
        </div>
        <nav class="resume-version-toggle" aria-label="Resume version">
          <a href={toBasePath('/resume/short-highlight')} aria-current="page">Short</a>
          <a href={toBasePath(detailedPath)}>Detailed</a>
        </nav>
      </div>

      <object class="resume-pdf-viewer" data={toBasePath(shortPdfPreview)} type="application/pdf">
        <iframe class="resume-pdf-viewer" src={toBasePath(shortPdfPreview)} title="Kitani Islam short CV"></iframe>
        <p>
          Your browser cannot preview this PDF.
          <a href={toBasePath(shortPdf)} download>Download the PDF</a>.
        </p>
      </object>
    </section>

    <ContactModal
      email={portfolio.meta.email}
      whatsappHref={portfolio.footer.socials.find((social) => social.icon === 'wa')?.href ?? ''}
      contraUsername="kitani_islam"
      contraAnalyticsUserId="9d0659f2-f1ac-4bdf-b684-e1a582a2ed65"
    />
  </main>
</MainLayout>
